#!/usr/bin/env racket
#lang racket

(provide gcc-custom-path)

;; ============================================================================
;; 可执行文件路径自定义配置
;; ============================================================================
;; 如果需要自定义编译器的位置，请在这里设置路径
;; 设置为 #f 表示使用自动检测
;; 路径应该是可执行文件的完整路径
;; ============================================================================

;; GCC/G++ 编译器路径
;; 示例 (指定版本): "/usr/bin/g++-15"
;; 示例 (macOS Homebrew): "/opt/homebrew/bin/g++-15"
;; 示例 (自定义编译): "/opt/gcc-15.2.0/bin/g++"
;; 示例 (自动检测): #f
(define gcc-custom-path #f)

;; ============================================================================
;; 配置说明
;; ============================================================================
;;
;; 1. 自动检测模式（默认）
;;    - 将路径设置为 #f
;;    - 自动搜索顺序：
;;      a. g++-15 (优先)
;;      b. g++ (系统默认)
;;    - 使用 find-executable-path 在 PATH 中搜索
;;
;; 2. 自定义路径模式
;;    - 设置具体的可执行文件路径
;;    - 可以是绝对路径或相对路径
;;    - 示例：
;;      (define gcc-custom-path "/usr/local/gcc-15/bin/g++")
;;      或
;;      (define gcc-custom-path "g++-14")  ; 在 PATH 中搜索
;;
;; 3. 常见配置场景
;;
;;    场景 1: 使用特定版本的 GCC
;;      (define gcc-custom-path "g++-14")
;;
;;    场景 2: 使用自编译的 GCC
;;      (define gcc-custom-path "/opt/custom-gcc/bin/g++")
;;
;;    场景 3: 使用系统默认 GCC
;;      (define gcc-custom-path "g++")
;;
;;    场景 4: 让构建系统自动选择（推荐）
;;      (define gcc-custom-path #f)
;;
;; ============================================================================
